{
  "name": "saas-e2e-reference-architecture",
  "build": { "dockerfile": "Dockerfile" },
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "onCreateCommand": "pip install -e '.[dev,app]'",
  "updateContentCommand": "docker compose build",
  "forwardPorts": [8000, 8025, 7900],
  "portsAttributes": {
    "8000": { "label": "Demo ESP App" },
    "8025": { "label": "Mailpit inbox" },
    "7900": { "label": "Live UI tests" }
  },
  "hostRequirements": { "cpus": 4, "memory": "8gb" }
}
